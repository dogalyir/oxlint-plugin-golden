{
  "name": "oxlint-plugin-golden",
  "version": "0.1.1",
  "description": "Opinionated Oxlint rules derived from a strict TypeScript coding standard: no forced casts, no unknown flow, explicit control flow, domain naming.",
  "keywords": [
    "oxlint",
    "oxc",
    "plugin",
    "linter",
    "typescript",
    "eslint",
    "code-quality"
  ],
  "homepage": "https://github.com/dogalyir/oxlint-plugin-golden#readme",
  "bugs": {
    "url": "https://github.com/dogalyir/oxlint-plugin-golden/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogalyir/oxlint-plugin-golden.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external @oxlint/plugins",
    "prepack": "bun run build",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.79.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
